# Copy to /home/wowzario/research.aliyanfaisal.com/.env on the server.
# Paste a key generated locally (php artisan key:generate --show); vendor/ is not on the server before the first deploy.
# This site has no database: sessions and cache use files.
APP_NAME="Aliyan Faisal — Research"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://research.aliyanfaisal.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12
