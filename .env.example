APP_NAME="Aliyan Faisal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# On shared/cPanel hosting, switch to the MySQL database cPanel gives you:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpanelusername_dbname
# DB_USERNAME=cpanelusername_dbuser
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set MAIL_MAILER=smtp and fill these in with your hosting's mail settings
# (usually mail.yourdomain.com, port 587/tls or 465/ssl) to send real email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact form submissions are emailed to. Defaults to MAIL_FROM_ADDRESS if unset.
MAIL_CONTACT_RECIPIENT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GITHUB_USERNAME=aliyanfaisal
GITHUB_TOKEN=

# Shared-secret bearer token required by external automations to call POST /api/blog-posts.
# Generate a long random value, e.g. via `php artisan tinker` -> `Str::random(40)`.
BLOG_API_TOKEN=

# Cuelara (Next.js site) endpoint and shared bearer token used to push new blog posts.
# CUELARA_API_URL is the full URL of the receiving endpoint, e.g. https://cuelara.com/api/blog-posts
CUELARA_API_URL=
CUELARA_API_TOKEN=

# Telegram channel auto-posting. The channel itself (@name or numeric id) is set in the admin Settings page.
TELEGRAM_BOT_TOKEN=

# LinkedIn Developer App credentials (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect products).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

# Shared secret required as ?key= on GET /auth/linkedin to start the one-time OAuth connect flow.
# Generate a long random value, e.g. via `php -r 'echo bin2hex(random_bytes(20));'`.
LINKEDIN_CONNECT_KEY=

# Shared-secret bearer token required by external automations to call POST /api/linkedin-post.
LINKEDIN_API_TOKEN=

# Cloudflare Turnstile widget keys (spam protection on blog comments) — https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Indexing API — absolute path to a service-account JSON key (the service account must be an Owner in Search Console). Leave empty to disable.
GOOGLE_INDEXING_CREDENTIALS=
